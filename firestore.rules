rules_version = '2';
// Casa Co-op — © 2026 Kevin Paulo (@Arkev.arq) · Licença MIT
// Regras de segurança do Casa Co-op.
// Cada "casa" tem no máximo 2 membros. Só membros leem e escrevem os dados da casa.
// Só o dono (quem criou a casa) aprova sugestões.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function houseData(h) { return get(/databases/$(database)/documents/houses/$(h)).data; }
    function isMember(h) { return signedIn() && request.auth.uid in houseData(h).members; }

    // ADMIN_UID: troque pelo seu UID (a página admin.html mostra qual é).
    function isAdmin() { return signedIn() && request.auth.uid == 'cJlpKeeaNhSeIBnHhqItvCTGAxx2'; }

    // Presença: cada pessoa grava só a própria; só o administrador lê.
    match /presence/{uid} {
      allow write: if signedIn() && request.auth.uid == uid;
      allow read: if isAdmin();
    }

    // Sugestões enviadas ao administrador: quem envia vê só as suas; o administrador lê e responde.
    match /feedback/{id} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'nova'
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 600;
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Sessões de uso: cada pessoa grava só as suas; só o administrador lê.
    match /sessions/{sid} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn() && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid;
      allow read: if isAdmin();
    }

    // Cada pessoa guarda só "qual é a minha casa".
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /houses/{h} {
      allow read: if (signedIn() && request.auth.uid in resource.data.members) || isAdmin();

      allow create: if signedIn()
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.p1.uid == request.auth.uid
        && request.resource.data.inviteCode is string
        && request.resource.data.inviteCode.size() >= 8;

      allow update: if signedIn() && (
        // 1) Membros mudam nome do jogo, nomes e cores — nunca dono, membros, código ou quem é quem.
        ( request.auth.uid in resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['appName', 'p1', 'p2', 'joinCode'])
          && request.resource.data.p1.uid == resource.data.p1.uid
          && request.resource.data.p2.uid == resource.data.p2.uid )
        ||
        // 2) Entrar com convite: só se a casa tem 1 membro e o código bate.
        ( !(request.auth.uid in resource.data.members)
          && resource.data.members.size() == 1
          && request.resource.data.members.size() == 2
          && request.resource.data.members.hasAll(resource.data.members)
          && request.auth.uid in request.resource.data.members
          && request.resource.data.joinCode == resource.data.inviteCode
          && request.resource.data.p2.uid == request.auth.uid
          && request.resource.data.p1 == resource.data.p1
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'p2', 'joinCode']) )
      );

      allow delete: if signedIn() && request.auth.uid == resource.data.owner;

      // Aprovação de sugestões: todos da casa leem, só o dono escreve.
      match /approvals/{id} {
        allow read: if isMember(h);
        allow write: if signedIn() && request.auth.uid == houseData(h).owner;
      }

      // Tarefas, cartas, sugestões e log: os dois leem e escrevem.
      match /{col}/{id} {
        allow read, write: if col in ['tasks', 'cards', 'suggestions', 'events'] && isMember(h);
      }
    }
  }
}
